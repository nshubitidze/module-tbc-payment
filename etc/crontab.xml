<?xml version = "1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="shubo_tbc_pending_order_reconciler"
             instance="Shubo\TbcPayment\Cron\PendingOrderReconciler"
             method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <!-- IMPROVE-4: settlement-recovery cron. Re-drives split settlement for
             PROCESSING TBC orders whose settlement is empty or last-failed, with
             a capped attempt count; alerts (→ Sentry) when the cap is exceeded.
             Runs every 15 minutes so a fresh capture's synchronous settlement
             gets a head start before recovery kicks in. -->
        <job name="shubo_tbc_settlement_reconciler"
             instance="Shubo\TbcPayment\Cron\SettlementReconciler"
             method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
    </group>
</config>
