<?xml version = "1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Service contract binding -->
    <preference for="Shubo\TbcPayment\Api\Data\SplitPaymentDataInterface"
                type="Shubo\TbcPayment\Model\SplitPaymentData"/>

    <!-- Payment Method Facade -->
    <virtualType name="ShuboTbcPaymentFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Shubo\TbcPayment\Model\Ui\ConfigProvider::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Shubo\TbcPayment\Block\Payment\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">ShuboTbcValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ShuboTbcCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- Config reader -->
    <virtualType name="ShuboTbcPaymentConfig" type="Shubo\TbcPayment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Shubo\TbcPayment\Model\Ui\ConfigProvider::CODE</argument>
        </arguments>
    </virtualType>

    <!-- Inject virtual config into all gateway classes -->
    <type name="Shubo\TbcPayment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Shubo\TbcPayment\Model\Ui\ConfigProvider::CODE</argument>
        </arguments>
    </type>

    <!-- Value Handler Pool -->
    <virtualType name="ShuboTbcValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ShuboTbcConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ShuboTbcConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">ShuboTbcPaymentConfig</argument>
        </arguments>
    </virtualType>

    <!-- Command Pool -->
    <virtualType name="ShuboTbcCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="refund" xsi:type="string">ShuboTbcRefundCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Refund Command -->
    <virtualType name="ShuboTbcRefundCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Shubo\TbcPayment\Gateway\Request\RefundRequestBuilder</argument>
            <argument name="transferFactory" xsi:type="object">Shubo\TbcPayment\Gateway\Http\TransferFactory</argument>
            <argument name="client" xsi:type="object">Shubo\TbcPayment\Gateway\Http\Client\RefundClient</argument>
            <argument name="handler" xsi:type="object">Shubo\TbcPayment\Gateway\Response\RefundHandler</argument>
            <!-- Session 3 Pass 4 (reviewer-signoff M-1): NO validator wired here.
                 Magento\Payment\Gateway\Command\GatewayCommand::execute() runs
                 the validator BEFORE the handler. If a validator is present
                 and returns invalid, processErrors() throws a generic
                 CommandException ("Transaction has been declined. Please try
                 again later.") and the handler is never invoked — meaning
                 RefundHandler's UserFacingErrorMapper friendly-message path
                 (Pass 1 Change A) becomes dead code on the failure path.
                 RefundHandler is the sole gatekeeper for Flitt refund
                 response validation. See docs/online-refund-rca.md
                 §"Pass 4 follow-up" and docs/reviewer-signoff.md M-1. -->
        </arguments>
    </virtualType>

    <!-- Logger -->
    <virtualType name="ShuboTbcLogger" type="Magento\Payment\Model\Method\Logger">
        <arguments>
            <argument name="config" xsi:type="object">ShuboTbcPaymentConfig</argument>
        </arguments>
    </virtualType>

    <!-- Inject logger virtual type where needed -->
    <type name="Shubo\TbcPayment\Gateway\Http\Client\RefundClient">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Gateway\Response\RefundHandler">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Payment\Callback">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <!-- IMPROVE-2: shared advisory-lock service for capture-path serialization. -->
    <type name="Shubo\TbcPayment\Service\PaymentLock">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <!-- IMPROVE-8: applier logs the critical amount-mismatch on the dedicated
         payment channel so it lands in Sentry, not just the local log file. -->
    <type name="Shubo\TbcPayment\Service\OrderApprovalApplier">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Gateway\Validator\CallbackValidator">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Payment\Confirm">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Payment\ReturnAction">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <!-- OrderLocator resolves the Magento order behind a Flitt order_id on the
         frontend capture paths (Callback/Confirm/ReturnAction). Its warning logs
         (bad order_id format, flitt_order_id mismatch) belong on the dedicated
         payment channel, same as the controllers that consume it. -->
    <type name="Shubo\TbcPayment\Model\OrderLocator">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Payment\Params">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Payment\AbortRedirect">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <!-- Dedicated log file for TBC payment.

         The `sentry` item is re-listed alongside the dedicated file handler
         because Magento's DI ObjectManager treats a virtualType `handlers`
         array as a full REPLACEMENT, not a merge with the base
         Magento\Framework\Logger\Monolog handlers. Without it, the
         Shubo\Ops\Logger\SentryHandler that Shubo_Ops merges into the base
         Monolog is stripped from this dedicated channel — every callback
         4xx/5xx, signature mismatch, reconciler error and settlement failure
         would land in shubo_tbc_payment.log ONLY and never reach Sentry.
         SentryHandler is shared="true" (declared in Shubo_Ops di.xml),
         self-rate-limits and scrubs PII. Cross-module DI reference only — no
         PHP `use` of the Ops class anywhere in TbcPayment. -->
    <virtualType name="ShuboTbcPaymentLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">shubo_tbc_payment</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">ShuboTbcPaymentLogHandler</item>
                <item name="sentry" xsi:type="object">Shubo\Ops\Logger\SentryHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ShuboTbcPaymentLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/shubo_tbc_payment.log</argument>
        </arguments>
    </virtualType>

    <!-- Shared Flitt HTTP transport (SIMPLIFY-2). Owns the curl/timeout/retry
         block and the response-side debug logging, so it logs to the dedicated
         channel. The per-client logger blocks below remain because the clients
         still emit request-side (sanitized) debug logs of their own. -->
    <type name="Shubo\TbcPayment\Gateway\Http\Client\FlittHttpClient">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Gateway\Http\Client\StatusClient">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Cron\PendingOrderReconciler">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Gateway\Http\Client\SettlementClient">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Service\SettlementService">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Adminhtml\Order\Settle">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Gateway\Http\Client\CaptureClient">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Adminhtml\Order\Capture">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Adminhtml\Order\VoidPayment">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <type name="Shubo\TbcPayment\Controller\Adminhtml\Order\CheckStatus">
        <arguments>
            <argument name="logger" xsi:type="object">ShuboTbcPaymentLogger</argument>
        </arguments>
    </type>

    <!-- Prod cutover CLI (GO_LIVE_CHECKLIST §3.1). Logger writes to a
         dedicated payment-cutover.log so the before/after snapshots are
         easy to audit on launch day and survive log rotation of the
         per-module files. -->
    <virtualType name="ShuboPaymentCutoverLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/payment-cutover.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="ShuboPaymentCutoverLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">shubo_payment_cutover</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">ShuboPaymentCutoverLogHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Shubo\TbcPayment\Console\Command\SwitchToProdCommand">
        <arguments>
            <argument name="cutoverLogger" xsi:type="object">ShuboPaymentCutoverLogger</argument>
        </arguments>
    </type>

    <!-- Bind CLI commands on the INTERFACE, never the concrete CommandList
         class. See KNOWN_ISSUES BUG-SETUP-1 Symptom 2 — binding on the
         concrete class forces Magento to eagerly resolve every command
         during CLI bootstrap, which breaks `setup:install` on cold DBs
         because Console commands touch Store/Website resolution. -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="shubo_payment_switch_to_prod_tbc"
                      xsi:type="object">Shubo\TbcPayment\Console\Command\SwitchToProdCommand</item>
            </argument>
        </arguments>
    </type>
</config>
